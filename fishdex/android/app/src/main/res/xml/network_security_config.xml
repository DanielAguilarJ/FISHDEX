<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security configuration for FishDex.

  The manifest previously set android:usesCleartextTraffic="true" application
  wide, which allowed unencrypted HTTP to any host. Session tokens, GPS
  coordinates and capture media all travel over this connection, so a passive
  network observer could read them and an active one could modify them.

  Cleartext is now denied by default. The only exceptions are the loopback
  addresses a developer uses to reach a server running on their own machine
  (10.0.2.2 is the host as seen from the Android emulator).

  If you must test against a plain-HTTP server on your LAN, add that specific IP
  to the debug-overrides block below — never re-enable cleartext globally.
-->
<network-security-config>

    <!-- Production and release builds: TLS only. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
      Debug builds only. Android ignores debug-overrides entirely in a release
      APK, so these exceptions cannot reach end users.
    -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <!-- Allows a locally installed proxy CA (e.g. mitmproxy, Charles). -->
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

    <!-- Loopback targets for local development, permitted in any build type. -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- The emulator's alias for the host machine. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

</network-security-config>
