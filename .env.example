# =============================================================================
# FishDex - Environment configuration
# =============================================================================
# Copy to `.env` and fill in real values:
#
#     cp .env.example .env
#
# `.env` is gitignored. Never commit real secrets.
#
# Generate each secret independently:
#
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# The server refuses to start in production while any secret still holds a
# placeholder value (see app/main.py::_assert_production_secrets).
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — Secrets
# ─────────────────────────────────────────────────────────────────────────────

# Server-to-server bearer secret. Also the HMAC key used to sign user session
# tokens, so rotating it invalidates every active session (users must log in
# again). Rotate immediately if it is ever exposed.
FISHDEX_AI_SERVER_SECRET=

# Shared secret bundled with the mobile app, sent as X-FishDex-Client-Secret.
# It identifies the *application*, not a user: every install carries the same
# value and it is extractable from the APK. It is therefore never sufficient on
# its own to read per-user data.
FISHDEX_CLIENT_SECRET=

# Secret for the operator dashboard and its WebSocket event stream.
FISHDEX_DASHBOARD_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — Environment
# ─────────────────────────────────────────────────────────────────────────────

# One of: development | staging | production | test
# `production` enables the strict guards: placeholder secrets are rejected,
# /docs and /redoc are disabled, the public /storage mount is turned off, and a
# CORS wildcard is refused.
FISHDEX_ENVIRONMENT=production

# Never set to true in production; the server refuses to start if you do.
FISHDEX_SKIP_AUTH=false


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — TLS / reverse proxy (consumed by Caddy)
# ─────────────────────────────────────────────────────────────────────────────

# Public FQDN. Use `localhost` for local development (Caddy then issues a
# certificate from its own internal CA). A real hostname triggers Let's Encrypt.
AI_DOMAIN=localhost

# ACME account email for certificate expiry notices.
TLS_EMAIL=admin@example.org

# Host ports Caddy publishes.
AI_SERVER_HTTPS_PORT=8443
AI_SERVER_HTTP_PORT=8080


# ─────────────────────────────────────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────────────────────────────────────

# Comma-separated browser origins allowed to call the API. Native mobile clients
# do not enforce CORS and need no entry here. `*` is rejected in production.
FISHDEX_CORS_ALLOWED_ORIGINS=https://localhost:8443


# ─────────────────────────────────────────────────────────────────────────────
# Models
# ─────────────────────────────────────────────────────────────────────────────

# YOLOv8 OBB detector weights (fish localisation + orientation).
FISHDEX_OBB_MODEL_PATH=models/detector/obb_best.pt
FISHDEX_OBB_CONF_THRESHOLD=0.35

# FishEncoder re-identification weights.
FISHDEX_REID_MODEL_PATH=models/reid/reid_best.pt
FISHDEX_REID_MODEL_NAME=convnext_small.fb_in22k_ft_in1k
FISHDEX_REID_EMBEDDING_DIM=512
FISHDEX_REID_IMG_SIZE=128

# Legacy ONNX detector/classifier (optional; the OBB pipeline supersedes them).
FISHDEX_DETECTOR_MODEL_PATH=models/detector/fish_detector_v1.onnx
FISHDEX_CLASSIFIER_MODEL_PATH=models/classifier/fish_species_v1.onnx
FISHDEX_CLASSIFIER_LABELS_PATH=models/classifier/labels.json

# cpu | cuda | cuda:0 | mps
FISHDEX_DEVICE=cpu


# ─────────────────────────────────────────────────────────────────────────────
# Matching thresholds
# ─────────────────────────────────────────────────────────────────────────────
# All probability-like values are validated to [0.0, 1.0] at startup, so a typo
# such as `0.82` written as `82` fails loudly instead of silently disabling
# matching.

# Cosine similarity required to declare a recapture. A false positive (merging
# two different fish) is worse than a false negative (a missed recapture), so
# this stays conservative. Calibrate with ai-server/scripts/calibrate_threshold.py
# before relying on it in production.
FISHDEX_REID_SIMILARITY_THRESHOLD=0.82

# Minimum gap between the best and second-best candidate.
FISHDEX_REID_MIN_MARGIN=0.05

# Two-level geographic search: inside the first radius a match may be applied
# automatically; between the two it is candidate-only.
FISHDEX_REID_AUTO_MATCH_RADIUS_KM=5.0
FISHDEX_REID_REVIEW_SEARCH_RADIUS_KM=50.0
FISHDEX_NEARBY_AREA_RADIUS_KM=5.0

# Embedding cache namespace. Changing it invalidates the gallery: rebuild with
# `python -m app.commands rebuild_embeddings`.
FISHDEX_REID_CACHE_NAME=fishencoder_convnext_small_512_128_v2

# Path to a calibration JSON. Empty means uncalibrated, which keeps automatic
# matching disabled.
FISHDEX_REID_CALIBRATION_PATH=

# Fingerprint (spot-pattern) crop. Only enable after rebuilding the index —
# embeddings computed with and without it are not comparable.
FISHDEX_REID_FINGERPRINT_CROP_ENABLED=false
FISHDEX_REID_FINGERPRINT_X_START=0.20
FISHDEX_REID_FINGERPRINT_X_END=0.80
FISHDEX_REID_FINGERPRINT_Y_START=0.05
FISHDEX_REID_FINGERPRINT_Y_END=0.55


# ─────────────────────────────────────────────────────────────────────────────
# Upload and frame processing
# ─────────────────────────────────────────────────────────────────────────────

# Keep below the Caddy request_body limit (55 MB) so clients get a JSON 413
# rather than a severed connection.
FISHDEX_MAX_VIDEO_SIZE_MB=50
FISHDEX_MAX_VIDEO_DURATION_SECONDS=15
FISHDEX_MAX_FRAMES_TO_EXTRACT=15
FISHDEX_MAX_FRAMES_TO_SAVE=8
FISHDEX_FRAME_MAX_SIDE=960
FISHDEX_JPEG_QUALITY=90


# ─────────────────────────────────────────────────────────────────────────────
# Result cache
# ─────────────────────────────────────────────────────────────────────────────
# The mobile client polls the result endpoint every 2 s while the result screen
# is open; caching the assembled document removes the repeated database work.

FISHDEX_RESULT_CACHE_ENABLED=true
FISHDEX_RESULT_CACHE_TTL_SECONDS=300
FISHDEX_RESULT_CACHE_MAX_ENTRIES=512


# ─────────────────────────────────────────────────────────────────────────────
# Storage paths (container-internal; adjust only for a bare-metal install)
# ─────────────────────────────────────────────────────────────────────────────

FISHDEX_SERVER_DATA_DIR=/app/data
FISHDEX_TEMP_DIR=/app/data/temp
FISHDEX_CACHE_DIR=/app/data/cache
FISHDEX_PRIVATE_DATA_DIR=/app/data/private
FISHDEX_FISH_DOCUMENTS_DIR=/app/data/private/fish_documents
FISHDEX_FISH_MEDIA_DIR=/app/data/storage/fish_media
FISHDEX_JOB_ARTIFACTS_DIR=/app/data/storage/jobs
FISHDEX_EMBEDDINGS_DB_PATH=/app/data/embeddings/fishdex_embeddings.sqlite


# ─────────────────────────────────────────────────────────────────────────────
# Container resource limits
# ─────────────────────────────────────────────────────────────────────────────

FISHDEX_CPU_LIMIT=2.0
FISHDEX_MEMORY_LIMIT=4G
FISHDEX_IMAGE_TAG=2.2.0


# ─────────────────────────────────────────────────────────────────────────────
# Appwrite (optional — legacy, being replaced by the local REST API)
# ─────────────────────────────────────────────────────────────────────────────

FISHDEX_APPWRITE_ENDPOINT=
FISHDEX_APPWRITE_PROJECT_ID=
FISHDEX_APPWRITE_API_KEY=
FISHDEX_APPWRITE_DATABASE_ID=fishdex_db


# ─────────────────────────────────────────────────────────────────────────────
# MCP codebase server (development tooling)
# ─────────────────────────────────────────────────────────────────────────────

# Loopback by default: this server has no authentication of its own and exposes
# the whole repository. Put an authenticated tunnel in front of it before
# changing the bind address.
FISHDEX_MCP_HOST=127.0.0.1
FISHDEX_MCP_PORT=8001


# ─────────────────────────────────────────────────────────────────────────────
# Offline ML scripts (only needed when training or evaluating)
# ─────────────────────────────────────────────────────────────────────────────

FISHDEX_OBB_DATASET_DIR=
FISHDEX_OBB_INPUT_DIR=
FISHDEX_OBB_OUTPUT_DIR=
FISHDEX_REID_SUPPORT_DIR=
FISHDEX_REID_QUERY_DIR=
FISHDEX_REID_RANDOM_SEED=1234


# =============================================================================
# Flutter app — NOT read from this file
# =============================================================================
# The mobile client takes its configuration at compile time. Nothing here is
# read by the app; pass values explicitly:
#
#   flutter build apk --release \
#     --dart-define=AI_SERVER_URL=https://ai.example.org \
#     --dart-define=AI_SERVER_SECRET="$FISHDEX_CLIENT_SECRET" \
#     --dart-define=APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1 \
#     --dart-define=APPWRITE_PROJECT_ID=your-project-id \
#     --dart-define=DATABASE_ID=fishdex_db
#
# AI_SERVER_URL must use https:// in release builds; the app refuses to start
# otherwise.
# =============================================================================
