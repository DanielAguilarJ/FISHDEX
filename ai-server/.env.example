# =============================================================================
# FishDex AI Server - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# All variables are prefixed with FISHDEX_ as per pydantic-settings config.
# =============================================================================

# ── Appwrite (REQUIRED) ─────────────────────────────────────────────────────
FISHDEX_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
FISHDEX_APPWRITE_PROJECT_ID=6a43bdeb0026006ff2f8
FISHDEX_APPWRITE_API_KEY=your-server-api-key-here
FISHDEX_APPWRITE_DATABASE_ID=fishdex_db

# ── Storage Buckets ─────────────────────────────────────────────────────────
FISHDEX_CAPTURE_RAW_VIDEOS_BUCKET=capture_raw_videos
FISHDEX_CAPTURE_FRAMES_BUCKET=capture_frames
FISHDEX_FISH_REFERENCE_IMAGES_BUCKET=fish_reference_images

# ── Models ──────────────────────────────────────────────────────────────────
FISHDEX_DETECTOR_MODEL_PATH=models/detector/fish_detector_v1.onnx
FISHDEX_CLASSIFIER_MODEL_PATH=models/classifier/fish_species_v1.onnx
FISHDEX_CLASSIFIER_LABELS_PATH=models/classifier/labels.json
FISHDEX_DETECTOR_TYPE=yolov8_obb

# ── Thresholds ──────────────────────────────────────────────────────────────
FISHDEX_CONFIDENCE_THRESHOLD=0.70
FISHDEX_DETECTOR_CONFIDENCE_THRESHOLD=0.30
FISHDEX_SIMILARITY_THRESHOLD=0.70

# ── Auth/Security ───────────────────────────────────────────────────────────
FISHDEX_SKIP_AUTH=false
FISHDEX_AI_SERVER_SECRET=change-me-in-production
FISHDEX_ENVIRONMENT=development

# ── Directories ─────────────────────────────────────────────────────────────
FISHDEX_SERVER_DATA_DIR=data
FISHDEX_TEMP_DIR=data/temp
FISHDEX_CACHE_DIR=data/cache
FISHDEX_EMBEDDINGS_DB_PATH=data/embeddings/fishdex_embeddings.sqlite
